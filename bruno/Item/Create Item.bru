meta {
  name: Create Item
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/item
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Sword of Power",
    "type": "weapon",
    "rarity": "legendary",
    "price": 1000
  }
}

docs {
  Crée un nouvel item.
  
  Nécessite un token JWT valide.
}
