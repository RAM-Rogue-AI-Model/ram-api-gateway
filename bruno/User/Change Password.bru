meta {
  name: Change Password
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/user/:id/password
  body: json
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "oldPassword": "Test123!@#",
    "newPassword": "NewTest123!@#"
  }
}

docs {
  Change le mot de passe d'un utilisateur.
  
  Nécessite un token JWT valide.
}
